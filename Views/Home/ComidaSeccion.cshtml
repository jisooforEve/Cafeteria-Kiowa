                    <div class="d-flex align-items-center justify-content-between px-2">
                        <button class="mt-4 btnMas" type="button"><i class="fa-solid fa-plus" style="color: rgb(117, 97, 71);"></i></button>
                        <span class="mt-4" style="font: 30px;">0</span> <!--Contador ira incremendado o decremetando segun la cantidad de producto-->
                        <button class="mt-4 btnMenos" type="button"> <i class="fa-solid fa-minus" style="color: rgb(117, 97, 71);"></i> </button>
                    </div>
                    <a class="btn btn-primary mt-4" asp-controller="Home" asp-action="ComplementosChilaquiles" asp-route-comida="Chilaquiles"> <strong>Agregar</strong> </a>
                </div>
