<div class="container contenedorToast">
    <div class="row justify-content-center  mx-0">

        <div class="col-auto">

            <div class="card estiloPedido" style="width: 500px;">
                <div class="card-body">
                    <h4 class="Personalizar pt-4"> <strong>Personaliza tus palomitas de pollo 😃</strong> </h4>
                    <p class="ParrafoPersonalizar pb-2">Selecciona los ingredientes que deseas</p>
                    <div class="mt-2 pt-2 border-top">

                        <form method="post">
                            <div class="row justify-content-center">

                                <div class="col-auto">
                                    <div class="btn-group mt-4" role="group">
                                        <input type="checkbox" class="btn-check" id="btncheck1" autocomplete="off" name="QuesoAmarillo">
                                        <label class="btn btn-outline-primary" for="btncheck1" style="border-color: #C08552; color: #C08552;">Queso amarillo</label>
                                    </div>
                                </div>

                                <div class="col-auto">
                                    <div class="btn-group mt-4" role="group">
                                        <input type="checkbox" class="btn-check" id="btncheck2" autocomplete="off" name="Ranch">
                                        <label class="btn btn-outline-primary" for="btncheck2" style="border-color: #C08552; color: #C08552;">Ranch</label>
                                    </div>
                                </div>

                                <div class="col-auto">
                                    <div class="btn-group mt-4" role="group">
                                        <input type="checkbox" class="btn-check" id="btncheck3" autocomplete="off" name="SalsaBufalo">
                                        <label class="btn btn-outline-primary" for="btncheck3" style="border-color: #C08552; color: #C08552;">Salsa bufalo</label>
                                    </div>
                                </div>

                            </div>
                        </form>

                        <hr />
                    </div>

                    <div class="row justify-content-center">
                        <div class="col-auto">
                            <a class="btn btn-success" asp-controller="Home" asp-action="CuentaPago">Aceptar</a>
                        </div>
                        <div class="col-auto">
                            <a class="btn btn-danger" asp-controller="Home" asp-action="ComidaSeccion">Volver a menú</a>
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.onload = function () {
            confetti({ particleCount: 80, angle: 60, spread: 55, origin: { x: 0, y: 0.6 } });
            confetti({ particleCount: 80, angle: 120, spread: 55, origin: { x: 1, y: 0.6 } });
        };
    </script>
}
