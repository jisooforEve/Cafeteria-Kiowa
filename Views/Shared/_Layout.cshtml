<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProyectoDSI_Avance</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProyectoDSI_Avance.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bitcount+Prop+Double+Ink:wght@100..900&family=Fira+Sans:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Lexend:wght@100..900&family=Noto+Serif:ital,wght@0,100..900;1,100..900&family=TikTok+Sans:opsz,wght@12..36,300..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

</head>
<body>

   <!--PARA EL EFECTO SCROLL REVEAL-->
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>AOS.init();</script>

    <nav class="navbar navbar-expand-lg p-3">
        <div class="container-fluid">
            <h1 class="tituloCafe"> CAFETERÍA KIOWA</h1>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="secciones" asp-controller="Home" asp-action="ComidaSeccion"> Comida <i class="fa-solid fa-bowl-food" style="color: rgb(117, 97, 71);"></i> </a>
                    </li>
                    <li class="nav-item">
                        <a class="secciones" asp-controller="Home" asp-action="BebidasSeccion" >Bebidas</a> <i class="fa-solid fa-bottle-water" style="color: rgb(117, 97, 71);"></i>
                    </li>
                    <li class="nav-item">
                        <a class="secciones" asp-controller="Home" asp-action="PostresSeccion">Postres</a> <i class="fa-solid fa-cookie-bite" style="color: rgb(117, 97, 71);"></i>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Carrito <i class="fa-solid fa-cart-shopping style="color: rgb(117, 97, 71);"></i> <!--Agregar contador de productos, osea que vaya incrementando de acuerdo a lo que el usuario -->
                        </a>
                        <ul class="dropdown-menu"> <!--Aqui sera el carrito y se pueden ver el pedido que el usuario realizo-->
                            <li><a class="dropdown-item" href="#">Action</a></li>
                        </ul>
                    </li>
                    
                </ul>

            </div>
        </div>
    </nav>
   
    <div >
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
