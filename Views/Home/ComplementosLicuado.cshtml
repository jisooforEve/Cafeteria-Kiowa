<div class="container contenedorToast">
    <div class="row justify-content-center mx-0">

        <div class="col-auto">

            <div class="card estiloPedido" style="width: 500px;">
                <div class="card-body">
                    <h4 class="Personalizar pt-4">
                        <strong>Personaliza tu licuado 🧋</strong>
                    </h4>

                    <p class="ParrafoPersonalizar pb-2">
                        Selecciona los ingredientes que deseas
                    </p>

                    <div class="mt-2 pt-2 border-top">

                        <form method="post" asp-action="AgregarEspecial">

                            <input type="hidden" name="idProducto" value="@ViewBag.IdProducto" />
                            <input type="hidden" name="cantidad" value="@ViewBag.Cantidad" />

                            <div class="row justify-content-center">

                                <p class="mt-3">¿Con qué fruta quieres tu licuado?</p>

                                <div class="col-auto">
                                    <input type="radio" value="Fresa" class="btn-check" name="fruta" id="fruta1">
                                    <label class="btn mb-3" for="fruta1"
                                           style="border-color: #8C5A3C; border-style: solid; color: #8C5A3C;">
                                        Fresa
                                    </label>
                                </div>

                                <div class="col-auto">
                                    <input type="radio" value="Platano" class="btn-check" name="fruta" id="fruta2">
                                    <label class="btn mb-3" for="fruta2"
                                           style="border-color: #8C5A3C; border-style: solid; color: #8C5A3C;">
                                        Plátano
                                    </label>
                                </div>

                                <div class="col-auto">
                                    <input type="radio" value="Mango" class="btn-check" name="fruta" id="fruta3">
                                    <label class="btn mb-3" for="fruta3"
                                           style="border-color: #8C5A3C; border-style: solid; color: #8C5A3C;">
                                        Mango
                                    </label>
                                </div>

                                <hr />

                                <!--  lecha -->
                                <p class="mt-3">Escoge el tipo de leche</p>

                                <div class="col-auto">
                                    <input type="radio" value="Leche entera" class="btn-check" name="leche" id="leche1">
                                    <label class="btn mb-3" for="leche1"
                                           style="border-color: #8C5A3C; border-style: solid; color: #8C5A3C;">
                                        Leche entera
                                    </label>
                                </div>

                                <div class="col-auto">
                                    <input type="radio" value="Leche deslactosada" class="btn-check" name="leche" id="leche2">
                                    <label class="btn mb-3" for="leche2"
                                           style="border-color: #8C5A3C; border-style: solid; color: #8C5A3C;">
                                        Leche deslactosada
                                    </label>
                                </div>

                                <div class="col-auto">
                                    <input type="radio" value="Leche light" class="btn-check" name="leche" id="leche3">
                                    <label class="btn mb-3" for="leche3"
                                           style="border-color: #8C5A3C; border-style: solid; color: #8C5A3C;">
                                        Leche light
                                    </label>
                                </div>

                            </div>

                            <hr />

                            <div class="row justify-content-center">
                                <div class="col-auto">
                                    <button type="submit" class="btn btn-success">
                                        Aceptar
                                    </button>
                                </div>

                                <div class="col-auto">
                                    <a class="btn btn-danger"
                                       asp-controller="Home"
                                       asp-action="ComidaSeccion">
                                        Volver a menú
                                    </a>
                                </div>
                            </div>

                        </form>

                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.onload = function () {
            confetti({ particleCount: 80, angle: 60, spread: 55, origin: { x: 0, y: 0.6 } });
            confetti({ particleCount: 80, angle: 120, spread: 55, origin: { x: 1, y: 0.6 } });
        };
    </script>
}